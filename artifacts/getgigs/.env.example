# Create a Google Maps browser key, enable the Maps JavaScript API and Places API (New), and restrict
# the key to this site's allowed web origins before using it in production.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Supabase Project URL and publishable key from Project Settings > API.
# The publishable/anon key is safe for browser use because database access is enforced by RLS.
# Never put a service_role key in a VITE_ variable or commit it to source control.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
